# 运行环境与模型服务配置示例。
# 复制为 .env 后按需修改；.env 不应提交到版本库。

# 提供方：auto | openai | ollama | demo
# auto：检测到 API Key 时使用在线模型，否则使用离线演示。
CODEINSIGHT_PROVIDER=auto

# 在线模型（OpenAI 兼容接口）
# CODEINSIGHT_API_KEY=sk-your-key
# CODEINSIGHT_MODEL=gpt-4o-mini
# 使用阿里云百炼、DeepSeek 等兼容服务时填写对应的 Base URL：
# CODEINSIGHT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地模型（Ollama）
# CODEINSIGHT_OLLAMA_BASE_URL=http://localhost:11434
# CODEINSIGHT_MODEL=qwen2.5-coder:7b

# 分析参数
CODEINSIGHT_TEMPERATURE=0.2
CODEINSIGHT_TIMEOUT=90
CODEINSIGHT_MAX_CODE_CHARS=20000
CODEINSIGHT_TRANSPORT_RETRIES=2
CODEINSIGHT_PARSE_RETRIES=1

# 结构化输出方式：json（默认，兼容性最好）| native（模型原生结构化输出）
CODEINSIGHT_STRUCTURED_OUTPUT=json
